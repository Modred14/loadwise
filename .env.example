# ---- Required ----------------------------------------------------------------
# Neon connection string (use the pooled one: host contains "-pooler"). Server-side only.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Optional: point the frontend at a different backend (default is this app's /api) --
# NEXT_PUBLIC_API_BASE_URL=

# ---- Public URL of the app (used in reset-password and reminder emails) --------
APP_URL=https://your-app.example.com
# Extra origins allowed to make state-changing API calls (comma separated). Normally empty.
# ALLOWED_ORIGINS=

# ---- Scheduled jobs (reminders + daily workload snapshots) --------------------
# Any long random string. Cron callers send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---- Email reminders and password reset (Resend, https://resend.com) ----------
# Without these, email is NOT sent and the app says so. It never pretends.
RESEND_API_KEY=
EMAIL_FROM=LoadWise <reminders@your-domain.example>

# ---- Push notifications (generate with: npm run vapid:generate) ---------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Tuning (optional) -------------------------------------------------------
# DEPT_MIN_COHORT=5     smallest group shown in departmental insights
# DB_POOL_MAX=5         connections per server instance
